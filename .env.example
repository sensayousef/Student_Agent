# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
# Every key the app needs must be documented here.

# App
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Add project-specific variables below this line

# Gemini (get a key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# FALSE = Gemini Developer API with an AI Studio key; TRUE = Vertex AI on Google Cloud
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash
# Only needed when GOOGLE_GENAI_USE_VERTEXAI=TRUE or when deploying to Cloud Run
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
